# KeepCryptoClean is read-only by default. Copy this file to .env for local
# development; never commit .env or credentials.

NODE_ENV=development
LOG_LEVEL=info
EXPRESS_PORT=3000

# Production-safe observer access. Use an X API bearer token restricted to the
# read-only endpoints this task needs. With no token, the adapter fails closed.
X_API_BEARER_TOKEN=
X_TARGET_USER_ID=

# There is intentionally no X user access token, password, cookie, reply mode,
# or browser flag. This rewarded task is strictly read-only.
