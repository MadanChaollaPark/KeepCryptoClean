# KeepCryptoClean is read-only by default. Copy this file to .env for local
# development; never commit .env or credentials.

NODE_ENV=development
LOG_LEVEL=info
# Production-safe observer access. Use an X API bearer token restricted to the
# read-only endpoints this task needs. With no token, the adapter fails closed.
X_API_BEARER_TOKEN=

# Consensus input for source-mode execution and composite checks. The build
# launcher does not read .env; `yarn test:ci` passes an exported value to its
# explicit --public-target-user-id argument. A bundled task cannot override it
# at runtime. Changing it requires a new reviewed artifact and task migration.
KCC_TARGET_USER_ID=

# Optional build provenance. Public-release builds must set this to the exact
# lowercase 40-character Git commit used as Complete Corresponding Source.
KCC_RELEASE_COMMIT=

# There is intentionally no X user access token, password, cookie, reply mode,
# or browser flag. This rewarded task is strictly read-only.
