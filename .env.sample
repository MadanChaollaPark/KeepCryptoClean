# --- Required: Twitter / X credentials --------------------------------------
# Use a dedicated VOLUNTEER account, not your primary one. The account must
# have already passed Twitter's verification flow (added phone, etc.) so the
# automated login does not trip a "verify your identity" challenge.

TWITTER_USERNAME="twitter username, no @"
TWITTER_PASSWORD="twitter password here"
TWITTER_PHONE="Phone number or email for the verification"

# --- Optional: cookie encryption --------------------------------------------
# 64 hex chars (32 bytes). If unset, lib/crypto.js generates an ephemeral key
# at process start, which means stored cookies cannot be decrypted across
# restarts and the node will have to log in fresh every boot.
#
#   Generate one with:  openssl rand -hex 32
#
# COOKIE_ENCRYPTION_KEY=""

# --- Optional: logging -------------------------------------------------------
# pino log level: trace | debug | info | warn | error | fatal (default: info)
#
# LOG_LEVEL="info"
