{
  "name": "keep-crypto-clean",
  "version": "3.0.0",
  "private": true,
  "description": "A safe-by-default Koii task for verifiable, read-only public-interest observations from X.",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "postinstall": "node scripts/patch-task-manager.js",
    "prebuild": "node scripts/patch-task-manager.js --check",
    "start": "node index.js",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "webpack": "yarn build:dev",
    "webpack:prod": "yarn build",
    "test": "yarn test:unit",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:ci": "yarn preflight && yarn format:check && yarn lint && yarn test:unit && yarn build && yarn verify:artifact && yarn verify:licenses && yarn smoke:artifact && yarn check:repository",
    "lint": "eslint --max-warnings=0 .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write \"**/*.{js,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{js,json,md,yaml,yml}\"",
    "preflight": "node scripts/preflight.js",
    "preflight:strict": "node scripts/preflight.js --strict",
    "verify:artifact": "node scripts/verify-artifact.js",
    "verify:licenses": "node scripts/verify-licenses.js",
    "verify:licenses:release": "node scripts/verify-release.js",
    "smoke:artifact": "node scripts/smoke-artifact.js",
    "check:repository": "node scripts/check-repository-hygiene.js",
    "audit:production": "node scripts/audit-production.js",
    "audit:all": "node scripts/audit-production.js --all"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MadanChaollaPark/KeepCryptoClean.git"
  },
  "bugs": {
    "url": "https://github.com/MadanChaollaPark/KeepCryptoClean/issues"
  },
  "homepage": "https://github.com/MadanChaollaPark/KeepCryptoClean#readme",
  "author": "Madan Chaolla Park and contributors",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "packageManager": "yarn@1.22.22",
  "resolutions": {
    "**/@babel/runtime": "7.29.7",
    "**/@_koii/namespace-wrapper/**/axios": "1.18.1",
    "**/axios/**/form-data": "4.0.6",
    "**/express": "4.22.2",
    "**/body-parser": "1.20.6",
    "**/express/**/path-to-regexp": "0.1.13",
    "**/secp256k1": "4.0.4",
    "**/elliptic": "6.6.1",
    "**/@_koii/web3.js/bn.js": "5.2.5",
    "**/borsh/**/bn.js": "5.2.5",
    "**/elliptic/**/bn.js": "4.12.5",
    "**/@_koii/web3.js/**/base-x": "3.0.11",
    "**/@_koii/storage-task-sdk/bs58/base-x": "4.0.1",
    "**/socket.io-stream/**/debug": "2.6.9",
    "**/cross-spawn": "7.0.6",
    "**/minimatch": "3.1.5",
    "**/flatted": "3.4.2",
    "**/rpc-websockets": "7.11.2",
    "**/eslint/**/js-yaml": "4.2.0",
    "**/eslint/**/ajv": "6.14.0",
    "**/minimatch/**/brace-expansion": "1.1.16",
    "**/@nestjs/platform-express/**/multer": "2.2.0",
    "**/lodash": "4.18.1",
    "**/jayson/**/ws": "7.5.11",
    "**/rpc-websockets/**/ws": "8.21.0",
    "**/body-parser/**/qs": "6.15.3",
    "**/@nestjs/platform-express/**/qs": "6.15.3"
  },
  "dependencies": {
    "@_koii/namespace-wrapper": "1.0.23",
    "@_koii/storage-task-sdk": "1.2.8",
    "@_koii/task-manager": "1.0.14",
    "@_koii/web3.js": "^0.1.11",
    "axios": "^1.18.1",
    "dotenv": "^16.6.1",
    "multiformats": "^14.0.4",
    "pino": "^9.14.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "webpack": "^5.108.4",
    "webpack-cli": "^5.1.4"
  }
}
