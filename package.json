    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0-rc.12",
    "multiformats": "^13.0.0",
    "dotenv": "^16.0.3",
    "dotenv-webpack": "^8.1.0",
    "express": "^4.18.1",
    "is-ipfs": "^8.0.4",
    "leveldown": "^6.1.1",
    "levelup": "^5.1.1",
